<Window x:Class="PW64Editor.App.Views.GameFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game files"
        Width="860" Height="620"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Filter" VerticalAlignment="Center" Margin="0,0,8,0" />
            <CheckBox x:Name="ProjectOnlyBox" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                      Content="Only files in the project" Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
            <TextBox x:Name="FilterBox" TextChanged="OnFilterChanged"
                     ToolTip="Type a file type (e.g. UPWT) or a table index" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="AddButton" Content="Add to project" Click="OnAdd" Style="{StaticResource DialogButton}" />
                <Button x:Name="RemoveButton" Content="Remove from project" Click="OnRemove" Style="{StaticResource DialogButton}" />
                <Button Content="Open files folder" Click="OnOpenFolder" Style="{StaticResource DialogButton}" />
                <Button Content="Close" IsCancel="True" Click="OnClose" Style="{StaticResource DialogButton}" />
            </StackPanel>
        </DockPanel>

        <DataGrid x:Name="FileGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                  SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnGridDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Index" Binding="{Binding TableIndex}" Width="60" />
                <DataGridTextColumn Header="Type" Binding="{Binding FileType}" Width="60" />
                <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="60" />
                <DataGridTextColumn Header="Number" Binding="{Binding GroupIndex}" Width="65" />
                <DataGridTextColumn Header="ROM offset" Binding="{Binding Offset}" Width="90" />
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" />
                <DataGridTextColumn Header="In project" Binding="{Binding State}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
