<UserControl x:Class="PW64Editor.App.Views.MissionsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PW64Editor.App.Views">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <!-- The sections of the Parameters tab can be folded; open by default, the state stays while missions change. -->
        <Style x:Key="Section" TargetType="Expander">
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="10">
        <!-- Mission selection, in the order of the game's menus. -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="Vehicle:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="VehicleBox" Width="170" DisplayMemberPath="Text" SelectionChanged="OnVehicleChanged" />
            <TextBlock Text="Test:" VerticalAlignment="Center" Margin="16,0,6,0" />
            <ComboBox x:Name="TestBox" Width="380" DisplayMemberPath="Text" SelectionChanged="OnTestChanged" />
        </WrapPanel>
        <!-- Undo and restore for the mission shown (a Cannonball level: all four targets). -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button x:Name="UndoButton" Content="Undo changes" Click="OnUndoChanges" Style="{StaticResource DialogButton}" Margin="0,0,8,0"
                    ToolTip="Back to the last saved state of this mission: drops the changes that are not saved yet." />
            <Button x:Name="RestoreButton" Content="Restore original" Click="OnRestoreOriginal" Style="{StaticResource DialogButton}"
                    ToolTip="Sets points, conditions, time limit and point texts of this mission back to the original game (title, task and hint stay as they are)." />
        </WrapPanel>
        <TextBlock x:Name="InfoText" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
        <Border x:Name="WarningBox" DockPanel.Dock="Top" Background="#FFF4E0" BorderBrush="#E8B04B" BorderThickness="1"
                Padding="8,5" Margin="0,6,0,0" Visibility="Collapsed">
            <TextBlock x:Name="WarningText" TextWrapping="Wrap" Foreground="#6B4500" />
        </Border>
        <TextBlock x:Name="SourceText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0"
                   Foreground="{StaticResource MutedTextBrush}" />

        <TabControl x:Name="SubTabs" Margin="0,8,0,0">
            <!-- Title, task and hint: a second place to edit these texts, the same as in the Text tab. -->
            <TabItem Header="Mission Statement">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,6,16,6" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Note}"
                                   Text="These are the same texts as in the Text tab: an edit here shows up there, and the other way round. They are saved together with the other texts (Ctrl+S)." />
                        <TextBlock x:Name="StatementNote" Style="{StaticResource Note}" Visibility="Collapsed" />
                        <local:TextEditorPanel x:Name="TitleEditor" ShowHeader="False" TextBoxHeight="44" Margin="0,4,0,0" />
                        <local:TextEditorPanel x:Name="TaskEditor" ShowHeader="False" TextBoxHeight="110" />
                        <local:TextEditorPanel x:Name="HintEditor" ShowHeader="False" TextBoxHeight="130" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- The points of the mission and the text of the mission screen ("…_S1"). -->
            <TabItem Header="Parameters">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,0,16,6" MaxWidth="900" HorizontalAlignment="Left">
                        <Expander Style="{StaticResource Section}">
                            <Expander.Header><TextBlock Text="Points" Style="{StaticResource SectionHeader}" /></Expander.Header>
                            <StackPanel Margin="18,0,0,0">
                        <!-- Birdman (game patch "Bonus games and Birdman"): free flight or a mission with points. -->
                        <CheckBox x:Name="BirdmanPointsBox" Content="Mission with points" Margin="0,4,0,0" Click="OnBirdmanPointsChanged" Visibility="Collapsed" />
                        <TextBlock x:Name="BirdmanPointsNote" Style="{StaticResource Note}" Visibility="Collapsed" />
                        <TextBlock x:Name="PointsNote" Style="{StaticResource Note}" />
                        <!-- One line per row of the result sheet, plus one to add a row; filled in code. -->
                        <!-- The rows can be dragged by their handle (⠿) to another place. -->
                        <Grid x:Name="PointsGrid" Margin="0,6,0,0" AllowDrop="True" Background="Transparent"
                              DragOver="OnRowDragOver" DragLeave="OnRowDragLeave" Drop="OnRowDrop">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="56" />
                                <ColumnDefinition Width="Auto" MinWidth="190" />
                                <ColumnDefinition Width="Auto" MinWidth="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <TextBlock x:Name="SumText" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="SumWarning" TextWrapping="Wrap" Foreground="{StaticResource ChangedBrush}" Visibility="Collapsed" />

                        <!-- Points per ring type (only for missions with rings). -->
                        <StackPanel x:Name="RingPanel" Margin="0,10,0,0">
                            <TextBlock Text="Points per ring" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Note}"
                                       Text="Each ring gives the points of its type. Which ring has which type is set in the mission's objects. Rings of type 3 are invisible check rings (no model, no radar mark): flying through them unlocks the next rings, in Dark Cavern the goal ring. They give no points and do not count for the conditions." />
                            <WrapPanel x:Name="RingTypes" Margin="0,4,0,0" />
                        </StackPanel>
                        </StackPanel>
                        </Expander>

                        <!-- Time limit, "Land now" and hard end (not for Cannonball). -->
                        <Expander x:Name="TimeSection" Style="{StaticResource Section}">
                            <Expander.Header><TextBlock Text="Time limit" Style="{StaticResource SectionHeader}" /></Expander.Header>
                            <StackPanel Margin="18,0,0,0">
                        <TextBlock x:Name="TimeNote" Style="{StaticResource Note}" />
                        <StackPanel x:Name="TimePanel">
                            <WrapPanel Margin="0,4,0,0">
                                <TextBlock Text="Kind:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox x:Name="TimeShapeBox" Width="300" SelectionChanged="OnTimeShapeChanged" />
                            </WrapPanel>
                            <WrapPanel x:Name="PlateauPanel" Margin="0,6,0,0">
                                <TextBlock Text="Full points up to" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="FullUntilBox" Width="60" Tag="time" />
                                <TextBlock Text="seconds, no points from" VerticalAlignment="Center" Margin="6,0,6,0" />
                                <TextBox x:Name="ZeroAtBox" Width="60" Tag="time" />
                                <TextBlock Text="seconds on." VerticalAlignment="Center" Margin="6,0,0,0" />
                            </WrapPanel>
                            <WrapPanel x:Name="TargetPanel" Margin="0,6,0,0">
                                <TextBlock Text="Target time" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="TargetTimeBox" Width="60" Tag="time" />
                                <TextBlock Text="seconds, full points within ±" VerticalAlignment="Center" Margin="6,0,6,0" />
                                <TextBox x:Name="WindowBox" Width="50" Tag="time" />
                                <TextBlock Text="seconds, no points beyond ±" VerticalAlignment="Center" Margin="6,0,6,0" />
                                <TextBox x:Name="ZeroDistanceBox" Width="50" Tag="time" />
                                <TextBlock Text="seconds." VerticalAlignment="Center" Margin="6,0,0,0" />
                            </WrapPanel>
                            <!-- Only for "Custom points": every point of the curve. -->
                            <StackPanel x:Name="TimeCurvePanel" Margin="0,6,0,0" />
                            <TextBlock x:Name="TimeCurveText" Style="{StaticResource Note}" Margin="0,6,0,0" />
                        </StackPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock Text="&quot;Land now&quot; after" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="LandNowBox" Width="60" Tag="value" />
                            <TextBlock Text="seconds (0 = off; the mission objects are removed then)." VerticalAlignment="Center" Margin="6,0,0,0" />
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock Text="Hard end after" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="HardEndBox" Width="60" Tag="value" />
                            <TextBlock Text="seconds (0 = off; the mission ends at once, also in the air)." VerticalAlignment="Center" Margin="6,0,0,0" />
                        </WrapPanel>
                        <StackPanel x:Name="HardEndModePanel" Margin="18,4,0,0">
                            <RadioButton x:Name="HardEndScoredBox" GroupName="HardEnd" Click="OnHardEndModeChanged"
                                         Content="The flight is scored: all points except landing accuracy and landing impact" />
                            <RadioButton x:Name="HardEndZeroBox" GroupName="HardEnd" Click="OnHardEndModeChanged" Margin="0,2,0,0"
                                         Content="The flight gives 0 points" />
                            <TextBlock Text="Jingle when the time is up:" Margin="0,8,0,2" />
                            <RadioButton x:Name="HardEndJingleOkBox" GroupName="HardEndJingle" Click="OnHardEndJingleChanged" Margin="18,0,0,0"
                                         Content="Landed successfully" />
                            <RadioButton x:Name="HardEndJingleMissBox" GroupName="HardEndJingle" Click="OnHardEndJingleChanged" Margin="18,2,0,0"
                                         Content="Landed wrongly" />
                            <RadioButton x:Name="HardEndJingleNoneBox" GroupName="HardEndJingle" Click="OnHardEndJingleChanged" Margin="18,2,0,0"
                                         Content="No jingle" />
                            <TextBlock x:Name="HardEndJingleNote" Style="{StaticResource Note}" Margin="18,2,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="HardEndText" Style="{StaticResource Note}" Margin="0,6,0,0"
                                   Text="With a hard end time the mission ends at that time, even in the air: for flights that need no landing (for example Birdman) or as a strict time limit. In the last 5 seconds a red countdown appears in the middle of the picture, then &quot;Time up!&quot;. Time points then use the end time; the conditions of the time points still apply. The footnote mentions it." />
                        </StackPanel>
                        </Expander>

                        <Expander x:Name="ConditionsExpander" Style="{StaticResource Section}">
                            <Expander.Header><TextBlock Text="Conditions and deductions" Style="{StaticResource SectionHeader}" /></Expander.Header>
                            <StackPanel Margin="18,0,0,0">
                        <StackPanel x:Name="ConditionsSection">
                            <StackPanel x:Name="CrashPanel">
                                <TextBlock Text="After a crash:" FontWeight="SemiBold" Margin="0,0,0,2" />
                                <RadioButton x:Name="CrashOriginalBox" GroupName="Crash" Click="OnConditionsChanged"
                                             Content="as in the original game (objects, deductions, altitude and distance count)" />
                                <RadioButton x:Name="CrashTimeBox" GroupName="Crash" Click="OnConditionsChanged" Margin="0,2,0,0"
                                             Content="the time points count too (with the time of the crash)" />
                                <RadioButton x:Name="CrashZeroBox" GroupName="Crash" Click="OnConditionsChanged" Margin="0,2,0,0"
                                             Content="0 points in total" />
                                <TextBlock x:Name="CrashTimeNote" Style="{StaticResource Note}" Margin="22,2,0,0" />
                            </StackPanel>
                            <TextBlock Text="Time points only if:" FontWeight="SemiBold" Margin="0,10,0,2" />
                            <TextBlock x:Name="TimeConditionsNote" Style="{StaticResource Note}" />
                            <!-- One line per object type of the mission; filled in code. -->
                            <Grid x:Name="ObjectConditionsGrid" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="160" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                            <CheckBox x:Name="LandWhenReachedBox" Margin="0,4,0,0" Click="OnConditionsChanged"
                                      Content="As soon as the number is reached: &quot;please land&quot;, the other objects disappear (as in the original game)" />
                            <WrapPanel Margin="0,4,0,0">
                                <CheckBox x:Name="AltitudeConditionBox" Content="the highest altitude reached at least" VerticalAlignment="Center" Click="OnConditionsChanged" />
                                <TextBox x:Name="AltitudeConditionValue" Width="60" Margin="6,0,6,0" Tag="value" />
                                <TextBlock Text="m" VerticalAlignment="Center" />
                            </WrapPanel>
                            <TextBlock x:Name="StartAltitudeNote" Style="{StaticResource Note}" Margin="22,0,0,0" />
                            <WrapPanel Margin="0,4,0,0">
                                <CheckBox x:Name="DistanceConditionBox" Content="the distance flown at least" VerticalAlignment="Center" Click="OnConditionsChanged" />
                                <TextBox x:Name="DistanceConditionValue" Width="60" Margin="6,0,6,0" Tag="value" />
                                <TextBlock Text="m" VerticalAlignment="Center" />
                            </WrapPanel>
                            <TextBlock x:Name="ConditionsHowNote" Style="{StaticResource Note}" Margin="0,6,0,0" />
                        </StackPanel>
                        <WrapPanel x:Name="HitPanel" Margin="0,8,0,0">
                            <TextBlock Text="Each hit costs" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="HitCostBox" Width="50" Tag="value" />
                            <TextBlock Text="point(s) (&quot;Points Deducted&quot;)." VerticalAlignment="Center" Margin="6,0,0,0" />
                        </WrapPanel>
                        <WrapPanel x:Name="OutOfAreaPanel" Margin="0,8,0,0">
                            <TextBlock Text="Leaving the area costs" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="OutOfAreaBox" Width="50" Tag="value" />
                            <TextBlock Text="point(s) each time." VerticalAlignment="Center" Margin="6,0,0,0" />
                        </WrapPanel>
                        <WrapPanel x:Name="ReactionPanel" Margin="0,8,0,0">
                            <TextBlock Text="The pilot cheers above" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="ReactionBox" Width="50" Tag="value" />
                            <TextBlock Text="points (set per mission)." VerticalAlignment="Center" Margin="6,0,0,0" />
                        </WrapPanel>
                        </StackPanel>
                        </Expander>

                        <!-- Only for missions with landing accuracy points (and the Cannonball targets). -->
                        <Expander x:Name="LandingPanel" Style="{StaticResource Section}">
                            <Expander.Header><TextBlock x:Name="LandingTitle" Text="Landing accuracy" Style="{StaticResource SectionHeader}" /></Expander.Header>
                            <StackPanel Margin="18,0,0,0">
                            <TextBlock x:Name="LandingNote" Style="{StaticResource Note}" />
                            <!-- Only for the Gyrocopter. -->
                            <CheckBox x:Name="SeparateTouchdownBox" Margin="0,6,0,0" Click="OnSeparateTouchdownChanged"
                                      Content="Own curve for the touchdown point" />
                            <StackPanel x:Name="LandingCurvePanel" Margin="0,6,0,0" />
                        </StackPanel>
                        </Expander>

                        <!-- Only for missions with landing impact points. -->
                        <Expander x:Name="ImpactPanel" Style="{StaticResource Section}">
                            <Expander.Header><TextBlock Text="Landing impact" Style="{StaticResource SectionHeader}" /></Expander.Header>
                            <StackPanel Margin="18,0,0,0">
                            <TextBlock x:Name="ImpactNote" Style="{StaticResource Note}" />
                            <StackPanel x:Name="ImpactCurvePanel" Margin="0,6,0,0" />
                        </StackPanel>
                        </Expander>

                        <!-- Pad radius, runway widths and the vehicle's speed limits; filled in code. -->
                        <Expander x:Name="GoodLandingPanel" Style="{StaticResource Section}">
                            <Expander.Header><TextBlock Text="Good landing" Style="{StaticResource SectionHeader}" /></Expander.Header>
                            <StackPanel Margin="18,0,0,0">
                            <TextBlock Style="{StaticResource Note}"
                                       Text="What decides a good landing (and a crash) in this mission. Speeds are in km/h like the speedometer of the HUD, distances in meters as the game counts them. The editor's game code sets the values while the mission is flown; the original values are those of every mission of the game." />
                            <Grid x:Name="GoodLandingGrid" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </StackPanel>
                        </Expander>

                        <!-- Only for missions with altitude points. -->
                        <Expander x:Name="AltitudePanel" Style="{StaticResource Section}">
                            <Expander.Header><TextBlock Text="Altitude points" Style="{StaticResource SectionHeader}" /></Expander.Header>
                            <StackPanel Margin="18,0,0,0">
                            <TextBlock Style="{StaticResource Note}"
                                       Text="The highest altitude of the flight gives the points of this curve. Between two points the points rise or fall evenly; below the first point the first one counts, above the last point the last one. Two points at the same altitude make a step. Altitudes are in meters above sea level, the number the HUD shows under &quot;SEA LEVEL&quot; (the altimeter shows the height above the ground): a flight from a tower or a mountain starts with that height." />
                            <StackPanel x:Name="AltitudeCurvePanel" Margin="0,6,0,0" />
                        </StackPanel>
                        </Expander>

                        <!-- Only for missions with distance points. -->
                        <Expander x:Name="DistancePanel" Style="{StaticResource Section}">
                            <Expander.Header><TextBlock Text="Distance points" Style="{StaticResource SectionHeader}" /></Expander.Header>
                            <StackPanel Margin="18,0,0,0">
                            <TextBlock Style="{StaticResource Note}"
                                       Text="The distance flown (the whole way, also up and down) gives the points of this curve. Distances are in meters as the game counts them. Between two points the points rise or fall evenly; beyond the last point the last one counts. The original result sheet has no line for these points: the editor's game code adds it." />
                            <StackPanel x:Name="DistanceCurvePanel" Margin="0,6,0,0" />
                        </StackPanel>
                        </Expander>

                        <!-- Only for Rocket Belt and Gyrocopter. -->
                        <Expander x:Name="FuelPanel" Style="{StaticResource Section}">
                            <Expander.Header><TextBlock Text="Fuel" Style="{StaticResource SectionHeader}" /></Expander.Header>
                            <StackPanel Margin="18,0,0,0">
                            <WrapPanel>
                                <TextBlock Text="Fuel at the start:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="StartFuelBox" Width="50" Tag="value" />
                                <TextBlock Text="% of a full tank" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </WrapPanel>
                            <CheckBox x:Name="UnlimitedFuelBox" Margin="0,6,0,0" Click="OnUnlimitedFuelChanged"
                                      Content="Unlimited fuel (the tank is filled again all the time)" />
                            <TextBlock x:Name="FuelNote" Style="{StaticResource Note}" Margin="22,2,0,0"
                                       Text="The editor's game code fills the tank in every frame of the flight. The fuel gauge and its &quot;FUEL&quot; label are not shown, and there is no &quot;Low fuel&quot;." />
                        </StackPanel>
                        </Expander>

                        <!-- Time of day, weather, snow and rain, fog, view distance and wind; filled in code. -->
                        <Expander x:Name="WeatherPanel" Style="{StaticResource Section}">
                            <Expander.Header><TextBlock Text="Weather and view" Style="{StaticResource SectionHeader}" /></Expander.Header>
                            <StackPanel Margin="18,0,0,0">
                            <WrapPanel x:Name="WeatherTargetPanel" Margin="0,4,0,0">
                                <TextBlock Text="Target:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox x:Name="WeatherTargetBox" Width="160" DisplayMemberPath="Text" SelectionChanged="OnWeatherTargetChanged" />
                                <TextBlock Style="{StaticResource Note}" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Text="Each target of a Cannonball level has its own weather." />
                            </WrapPanel>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="190" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Weather / time of day:" VerticalAlignment="Center" />
                                <ComboBox x:Name="WeatherBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Width="260" Margin="0,3,0,3"
                                          SelectionChanged="OnWeatherChanged" />

                                <TextBlock Grid.Row="1" Text="Weather effect:" VerticalAlignment="Center" />
                                <ComboBox x:Name="EffectBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Width="260" Margin="0,3,0,3"
                                          SelectionChanged="OnEffectChanged" />
                                <TextBlock x:Name="FallSpeedLabel" Grid.Row="2" Text="Fall speed:" VerticalAlignment="Center" Margin="18,0,0,0" />
                                <Slider x:Name="FallSpeedSlider" Grid.Row="2" Grid.Column="1" Width="220" Minimum="0" Maximum="30" SmallChange="0.5" LargeChange="5"
                                        TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,3,8,3" ValueChanged="OnWeatherSliderChanged" />
                                <TextBlock x:Name="FallSpeedText" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" MinWidth="110" />
                                <TextBlock x:Name="DensityLabel" Grid.Row="3" Text="Amount:" VerticalAlignment="Center" Margin="18,0,0,0" />
                                <Slider x:Name="DensitySlider" Grid.Row="3" Grid.Column="1" Width="220" Minimum="200" Maximum="1200" SmallChange="50" LargeChange="200"
                                        TickFrequency="50" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,3,8,3" ValueChanged="OnWeatherSliderChanged" />
                                <TextBlock x:Name="DensityText" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" MinWidth="110" />
                                <TextBlock x:Name="EffectColorLabel" Grid.Row="4" Text="Colour:" VerticalAlignment="Center" Margin="18,0,0,0" />
                                <ComboBox x:Name="EffectColorBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Width="260" Margin="0,3,0,3"
                                          SelectionChanged="OnEffectColorChanged" />

                                <TextBlock Grid.Row="5" Text="Fog colour:" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <ComboBox x:Name="FogColorBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Width="260" Margin="0,11,0,3"
                                          SelectionChanged="OnFogColorChanged" />
                                <CheckBox x:Name="SkyTintBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,3,0,3" Click="OnSkyTintChanged"
                                          Content="Tint the sky with it too" />
                                <TextBlock x:Name="FogColorNote" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource Note}" />

                                <TextBlock Grid.Row="8" Text="View distance:" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <Slider x:Name="ViewSlider" Grid.Row="8" Grid.Column="1" Width="220" Minimum="1000" Maximum="2100" SmallChange="50" LargeChange="100"
                                        TickFrequency="50" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,11,8,3" ValueChanged="OnWeatherSliderChanged" />
                                <TextBlock x:Name="ViewText" Grid.Row="8" Grid.Column="2" VerticalAlignment="Center" Margin="0,8,0,0" MinWidth="110" />
                                <CheckBox x:Name="FogAlignedBox" Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,3,0,3" Click="OnFogAlignedChanged"
                                          Content="Fog follows the view distance (as in the game)" />
                                <TextBlock x:Name="FogStartLabel" Grid.Row="10" Text="Fog starts at:" VerticalAlignment="Center" Margin="18,0,0,0" />
                                <Slider x:Name="FogStartSlider" Grid.Row="10" Grid.Column="1" Width="220" Minimum="0" Maximum="2000" SmallChange="10" LargeChange="100"
                                        TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,3,8,3" ValueChanged="OnWeatherSliderChanged" />
                                <TextBlock x:Name="FogStartText" Grid.Row="10" Grid.Column="2" VerticalAlignment="Center" MinWidth="110" />
                                <TextBlock x:Name="FogDensityLabel" Grid.Row="11" Text="Fog at the view distance:" VerticalAlignment="Center" Margin="18,0,0,0" />
                                <Slider x:Name="FogDensitySlider" Grid.Row="11" Grid.Column="1" Width="220" Minimum="10" Maximum="100" SmallChange="5" LargeChange="10"
                                        TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,3,8,3" ValueChanged="OnWeatherSliderChanged" />
                                <TextBlock x:Name="FogDensityText" Grid.Row="11" Grid.Column="2" VerticalAlignment="Center" MinWidth="110" />

                                <TextBlock Grid.Row="12" Text="Wind direction:" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <Slider x:Name="WindDirectionSlider" Grid.Row="12" Grid.Column="1" Width="220" Minimum="0" Maximum="355" SmallChange="5" LargeChange="45"
                                        TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,11,8,3" ValueChanged="OnWeatherSliderChanged" />
                                <TextBlock x:Name="WindDirectionText" Grid.Row="12" Grid.Column="2" VerticalAlignment="Center" Margin="0,8,0,0" MinWidth="110" />
                                <TextBlock Grid.Row="13" Text="Wind strength:" VerticalAlignment="Center" />
                                <Slider x:Name="WindStrengthSlider" Grid.Row="13" Grid.Column="1" Width="220" Minimum="0" Maximum="10" SmallChange="0.1" LargeChange="1"
                                        TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,3,8,3" ValueChanged="OnWeatherSliderChanged" />
                                <TextBlock x:Name="WindStrengthText" Grid.Row="13" Grid.Column="2" VerticalAlignment="Center" MinWidth="110" />
                                <TextBlock Grid.Row="14" Text="Direction varies:" VerticalAlignment="Center" Margin="18,0,0,0" />
                                <WrapPanel Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,3,0,3">
                                    <TextBlock Text="by ±" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <Slider x:Name="WindDirectionRangeSlider" Width="120" Minimum="0" Maximum="180" SmallChange="5" LargeChange="15"
                                            TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnWeatherSliderChanged" />
                                    <TextBlock x:Name="WindDirectionRangeText" VerticalAlignment="Center" MinWidth="45" Margin="4,0,12,0" />
                                    <TextBlock Text="rate" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <Slider x:Name="WindDirectionRateSlider" Width="120" Minimum="0" Maximum="90" SmallChange="1" LargeChange="10"
                                            TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnWeatherSliderChanged" />
                                    <TextBlock x:Name="WindDirectionRateText" VerticalAlignment="Center" MinWidth="55" Margin="4,0,0,0" />
                                </WrapPanel>
                                <TextBlock Grid.Row="15" Text="Strength varies:" VerticalAlignment="Center" Margin="18,0,0,0" />
                                <WrapPanel Grid.Row="15" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,3,0,3">
                                    <TextBlock Text="by ±" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <Slider x:Name="WindSpeedRangeSlider" Width="120" Minimum="0" Maximum="5" SmallChange="0.1" LargeChange="1"
                                            TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnWeatherSliderChanged" />
                                    <TextBlock x:Name="WindSpeedRangeText" VerticalAlignment="Center" MinWidth="45" Margin="4,0,12,0" />
                                    <TextBlock Text="rate" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <Slider x:Name="WindSpeedRateSlider" Width="120" Minimum="0" Maximum="10" SmallChange="0.1" LargeChange="1"
                                            TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnWeatherSliderChanged" />
                                    <TextBlock x:Name="WindSpeedRateText" VerticalAlignment="Center" MinWidth="55" Margin="4,0,0,0" />
                                </WrapPanel>
                            </Grid>
                            <TextBlock x:Name="WeatherNote" Style="{StaticResource Note}" Margin="0,6,0,0" />
                            <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0"
                                       Text="The wind blows towards the direction shown: 0° is north (up on the map of the mission), 90° east. Its strength is in meters per second; it pushes every vehicle. The variation lets strength and direction wander at random around the set value, at most by ± the amount; the rate says how fast (the game takes a random step of up to half of it per second). The weather effects, fog colour, fog and view distance are set by the editor's game code while the mission is flown." />
                        </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource Section}">
                            <Expander.Header><TextBlock Text="Footnote" Style="{StaticResource SectionHeader}" /></Expander.Header>
                            <StackPanel Margin="18,0,0,0">
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Shown below the total on the mission screen, with a * in front. One line per line of the text box." />
                        <CheckBox x:Name="AutoFootnoteBox" Margin="0,4,0,0" Click="OnAutoFootnoteChanged"
                                  Content="Write the footnote from the settings (time limit, conditions, altitude points, crash)" />
                        <TextBox x:Name="FootnoteBox" Height="70" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas"
                                 LostKeyboardFocus="OnFootnoteCommitted" />
                        </StackPanel>
                        </Expander>

                        <!-- Only for the Beginner missions of Hang Glider, Rocket Belt and Gyrocopter. -->
                        <Expander x:Name="DemoPanel" Style="{StaticResource Section}">
                            <Expander.Header><TextBlock Text="Hint screen" Style="{StaticResource SectionHeader}" /></Expander.Header>
                            <StackPanel Margin="18,0,0,0">
                            <CheckBox x:Name="HideDemoBox" Click="OnHideDemoChanged"
                                      Content="Hide the &quot;View Demo&quot; button (the demo flight can no longer be chosen)" />
                            <TextBlock Style="{StaticResource Note}" Margin="22,2,0,0"
                                       Text="The hint screen of the Beginner missions offers a demo flight. Without the button it works like the hint screens of the other classes: only &quot;Return&quot;." />
                        </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource Section}">
                            <Expander.Header><TextBlock Text="Text on the mission screen" Style="{StaticResource SectionHeader}" /></Expander.Header>
                            <StackPanel Margin="18,0,0,0">
                        <TextBlock x:Name="ScreenTextNote" Style="{StaticResource Note}" />
                        <local:TextEditorPanel x:Name="ScreenTextView" ShowHeader="False" IsReadOnly="True" TextBoxHeight="150" />
                        </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- The result sheet after the mission ("…_S2"). -->
            <TabItem Header="Results">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,0,16,6" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="Result sheet" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="ResultRowsText" TextWrapping="Wrap" />
                        <TextBlock x:Name="ResultTextNote" Style="{StaticResource Note}" Margin="0,8,0,0" />
                        <local:TextEditorPanel x:Name="ResultTextView" ShowHeader="False" IsReadOnly="True" TextBoxHeight="150" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
