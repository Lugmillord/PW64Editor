<UserControl x:Class="PW64Editor.App.Views.MenuTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,6" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>
    </UserControl.Resources>

    <!-- When the fields of the level select open: one list of conditions per field. Every change is saved in the project
         right away and takes effect with the next build. -->
    <DockPanel Margin="16,10,16,10">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource Note}" MaxWidth="1000" HorizontalAlignment="Left"
                       Text="When the fields of the vehicle and class select open: a field opens when all of its conditions are met (a field without conditions is open from the start). A condition asks for the points or the badge of another class, level or stage; the badges follow the limits of the Classes tab. Every change is saved in the project right away and takes effect with the next build (Ctrl+S)." />
            <WrapPanel Margin="0,8,0,0">
                <Button x:Name="OriginalButton" Content="Back to the game's rules" Style="{StaticResource DialogButton}" Click="OnOriginal" />
                <TextBlock x:Name="RulesText" VerticalAlignment="Center" Margin="12,0,0,0" />
            </WrapPanel>
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="FieldList" Grid.Column="0" SelectionChanged="OnFieldChanged" />
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel Margin="16,0,0,0">
                    <TextBlock x:Name="FieldTitle" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="FieldNote" Style="{StaticResource Note}" />
                    <Grid x:Name="ConditionGrid" Margin="0,8,0,0" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="AddButton" Content="Add condition" Style="{StaticResource DialogButton}" Click="OnAdd" />
                        <Button x:Name="FieldOriginalButton" Content="The game's conditions for this field" Style="{StaticResource DialogButton}"
                                Margin="8,0,0,0" Click="OnFieldOriginal" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
