<Window x:Class="PW64Editor.App.Views.TextCodesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Text codes"
        Width="860" Height="720"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Codes that should not be used are greyed out. -->
        <Style x:Key="CodeRow" TargetType="ListViewItem">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Usable}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- List 1: how things are written in the editor. -->
        <TextBlock Grid.Row="0" Text="How texts are written" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ListView Grid.Row="1" x:Name="MarkupList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Written as" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Syntax}" FontFamily="Consolas" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Meaning" Width="500">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Meaning}" TextWrapping="Wrap" Width="480" Margin="0,3" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Stored as" Width="170">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StoredAs}" FontFamily="Consolas" TextWrapping="Wrap" Width="160" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- List 2: every single code. -->
        <StackPanel Grid.Row="2" Margin="0,16,0,6">
            <TextBlock Text="All codes" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"
                       Text="Every code a text can contain, read from the game's font. Grey codes should not be used. The font has no umlauts, accents or ß." />
        </StackPanel>
        <ListView Grid.Row="3" x:Name="CodeList" ItemContainerStyle="{StaticResource CodeRow}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Code" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CodeHex}" FontFamily="Consolas" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Written as" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding WrittenAs}" FontFamily="Consolas" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Meaning" Width="600">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Meaning}" TextWrapping="Wrap" Width="580" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" IsCancel="True" IsDefault="True" Click="OnClose" Style="{StaticResource DialogButton}" />
        </StackPanel>
    </Grid>
</Window>
