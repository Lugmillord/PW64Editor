<UserControl x:Class="PW64Editor.App.Views.TexturesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SideButton" TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- All textures of the game in a grid, with filters above. -->
        <DockPanel>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="Format:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="FormatFilter" Width="120" SelectionChanged="OnFilterChanged" />
                <TextBlock Text="Size:" VerticalAlignment="Center" Margin="14,0,6,0" />
                <ComboBox x:Name="SizeFilter" Width="120" SelectionChanged="OnFilterChanged" />
                <CheckBox x:Name="ChangedOnlyBox" Content="Changed only" VerticalAlignment="Center" Margin="14,0,0,0"
                          Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
                <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource MutedTextBrush}" />
            </WrapPanel>

            <ListBox x:Name="TextureList" SelectionMode="Single" SelectionChanged="OnSelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderBrush="#D5DCE3">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="74" Margin="2" ToolTip="{Binding ToolTip}">
                            <Border x:Name="Frame" Width="70" Height="70" BorderThickness="2" BorderBrush="Transparent"
                                    Background="{StaticResource CheckerBrush}">
                                <Image Source="{Binding Thumbnail}" Width="64" Height="64" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Border>
                            <TextBlock x:Name="NumberLabel" Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource ChangedBrush}" />
                                <Setter TargetName="NumberLabel" Property="Foreground" Value="{StaticResource ChangedBrush}" />
                                <Setter TargetName="NumberLabel" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- The selected texture, enlarged, and the buttons. -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,0,0,0">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Text="No texture selected" />
                <Border Width="272" Height="272" Margin="0,8,0,0" HorizontalAlignment="Left"
                        Background="{StaticResource CheckerBrush}" BorderBrush="#D5DCE3" BorderThickness="1">
                    <Image x:Name="LargeImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
                <TextBlock x:Name="ResolutionText" Width="272" HorizontalAlignment="Left" TextAlignment="Center"
                           Margin="0,4,0,0" FontWeight="SemiBold" />
                <TextBlock x:Name="DetailsText" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock x:Name="ProblemText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#B3261E" Visibility="Collapsed" />

                <Button x:Name="ExportButton" Content="Export as PNG…" Click="OnExport" Style="{StaticResource SideButton}" Margin="0,12,0,0"
                        ToolTip="Saves the texture as it is now as a PNG image." />
                <Button x:Name="ReplaceButton" Content="Replace with PNG…" Click="OnReplace" Style="{StaticResource SideButton}"
                        ToolTip="Replaces the texture with an image of exactly the same size. A preview shows how the game will show it." />
                <Button x:Name="RestoreButton" Content="Restore original" Click="OnRestore" Style="{StaticResource SideButton}"
                        ToolTip="Removes the replaced image from the project, so the game uses its original texture again." />

                <Separator Margin="0,14,0,8" />
                <Button x:Name="ExportAllButton" Content="Export all (ZIP)…" Click="OnExportAll" Style="{StaticResource SideButton}"
                        ToolTip="Saves all textures as PNG images in a ZIP file. The file names contain number, size and format." />
                <Button x:Name="ImportAllButton" Content="Import all (ZIP)…" Click="OnImportAll" Style="{StaticResource SideButton}"
                        ToolTip="Replaces textures with the PNG images of a ZIP file. The number in each file name decides which texture it replaces." />

                <TextBlock x:Name="ActionText" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
