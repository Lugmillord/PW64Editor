<UserControl x:Class="PW64Editor.App.Views.SaveFileTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <!-- File buttons and the open file. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Open save file…" Click="OnOpen" Style="{StaticResource DialogButton}" Margin="0" />
                <Button x:Name="SaveButton" Content="Save" Click="OnSave" Style="{StaticResource DialogButton}" IsEnabled="False"
                        ToolTip="Writes the changes into the open file. Before the first change, a copy of the file is kept as .bak." />
                <Button x:Name="SaveAsButton" Content="Save as…" Click="OnSaveAs" Style="{StaticResource DialogButton}" IsEnabled="False"
                        ToolTip="Writes the save file to another file; the open file stays as it is." />
            </StackPanel>
            <TextBlock x:Name="FileText" Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource MutedTextBrush}" Text="No save file open." />
        </DockPanel>

        <Grid>
            <TextBlock x:Name="NoFileText" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                       Text="Open a save file of an emulator (the cartridge's EEPROM, usually .eep, 512 bytes) to see and change the points of the tests and the photo album." />

            <TabControl x:Name="SlotTabs" Visibility="Collapsed">
                <TabItem x:Name="Slot1Tab" Header="File 1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <ContentControl x:Name="Slot1Host" Margin="10" />
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="Slot2Tab" Header="File 2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <ContentControl x:Name="Slot2Host" Margin="10" />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Other">
                    <DockPanel Margin="10">
                        <TextBlock x:Name="OtherInfo" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBox x:Name="HexView" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</UserControl>
