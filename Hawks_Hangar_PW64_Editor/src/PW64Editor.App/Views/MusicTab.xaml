<UserControl x:Class="PW64Editor.App.Views.MusicTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <!-- Song selection. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="Song:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="SongList" Width="340" DisplayMemberPath="Text" SelectionChanged="OnSongChanged" />
            <Button x:Name="RestoreButton" Content="Restore original" Click="OnRestore" Style="{StaticResource DialogButton}" Margin="10,0,0,0"
                    ToolTip="Removes all changes of this song from the project." />
            <TextBlock x:Name="SongInfoText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource MutedTextBrush}" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{StaticResource MutedTextBrush}"
                   Text="Every change is saved in the project right away. Build the hack ROM (Ctrl+S) to hear it in the game. ▶ plays a short sample of the instrument (without the game's reverb)." />
        <TextBlock x:Name="ActionText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" />

        <!-- One row per voice (MIDI channel); filled in code. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid x:Name="VoiceGrid" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="170" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
