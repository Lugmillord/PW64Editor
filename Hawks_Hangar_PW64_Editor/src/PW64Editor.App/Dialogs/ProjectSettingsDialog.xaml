<Window x:Class="PW64Editor.App.Dialogs.ProjectSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:PW64Editor.App.Converters"
        Title="Project settings"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </Window.Resources>

    <StackPanel Margin="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                <TextBox x:Name="NameBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Version" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                <TextBox x:Name="VersionBox" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Author" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="AuthorBox" />

        <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="DescriptionBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" />

        <TextBlock Text="Hack ROM file" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Use default" Click="OnDefaultOutput" Style="{StaticResource DialogButton}" />
            <Button DockPanel.Dock="Right" Content="Change…" Click="OnChangeOutput" Style="{StaticResource DialogButton}" />
            <TextBox x:Name="OutputBox" IsReadOnly="True" />
        </DockPanel>

        <CheckBox x:Name="RelocateBox" Margin="0,16,0,0"
                  Content="Always move the audio data directly behind the game files" />
        <CheckBox x:Name="ExpandBox" Margin="0,8,0,0"
                  Content="Allow enlarging the ROM (16, 32 or 64 MiB) when the data does not fit" />

        <!-- Code fixes: corrections of bugs in the game's code. "Apply" acts at once (and rebuilds),
             independent of Save/Cancel. Applied fixes show a check mark on a gray background. -->
        <TextBlock Text="Code fixes" FontWeight="SemiBold" Margin="0,20,0,2" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                   Text="Corrections of bugs in the game's code. They become part of the hack ROM and its patch. Apply rebuilds the hack ROM right away and cannot be undone, except by returning to a restore point." />
        <ItemsControl x:Name="FixList" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,4" Padding="6,4" BorderBrush="#D5DCE3" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                        <Setter Property="Background" Value="#E9ECEF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Expander>
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Either the Apply button or a check mark, in the same place. -->
                                    <Grid Width="64">
                                        <Button Content="Apply" Click="OnApplyFix" Padding="8,1" HorizontalAlignment="Left"
                                                ToolTip="Apply this fix and rebuild the hack ROM"
                                                Visibility="{Binding IsApplied, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <TextBlock Text="✔" FontSize="15" FontWeight="Bold" Foreground="#2E7D32" Margin="6,0,0,0"
                                                   VerticalAlignment="Center" ToolTip="Applied"
                                                   Visibility="{Binding IsApplied, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="26,6,4,4">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Problem: " FontWeight="SemiBold" /><Run Text="{Binding Problem, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                                    <Run Text="Fix: " FontWeight="SemiBold" /><Run Text="{Binding Solution, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Expander>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="FixStatus" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save" Click="OnSave" IsDefault="True" Style="{StaticResource DialogButton}" />
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
        </StackPanel>
    </StackPanel>
</Window>
