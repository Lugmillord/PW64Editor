<Window x:Class="PW64Editor.App.Dialogs.PhotoScoringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="How photos are scored"
        Width="680" Height="620"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" IsCancel="True" IsDefault="True" Click="OnClose" Style="{StaticResource DialogButton}" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- Filled in code: a heading and a paragraph per topic. -->
            <StackPanel x:Name="SectionsPanel" />
        </ScrollViewer>
    </DockPanel>
</Window>
