<Window x:Class="PW64Editor.App.Dialogs.NewProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New project"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="Name of the hack" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" TextChanged="OnInputChanged" />

        <TextBlock Text="Location" Style="{StaticResource FieldLabel}" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowse" Style="{StaticResource DialogButton}" />
            <TextBox x:Name="LocationBox" TextChanged="OnInputChanged" />
        </DockPanel>

        <TextBlock x:Name="FolderPreview" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedTextBrush}" />

        <CheckBox x:Name="GitBox" Margin="0,16,0,0"
                  Content="Prepare for version control with Git (adds a .gitignore)" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CreateButton" Content="Create project" Click="OnCreate" IsDefault="True"
                    Style="{StaticResource DialogButton}" />
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
        </StackPanel>
    </StackPanel>
</Window>
