<Window x:Class="PW64Editor.App.Dialogs.TextureImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Replace texture"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" MaxWidth="560">
        <TextBlock x:Name="HeaderText" FontWeight="SemiBold" TextWrapping="Wrap" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Now" Margin="0,0,0,4" />
                <Border Width="256" Height="256" Background="{StaticResource CheckerBrush}" BorderBrush="#D5DCE3" BorderThickness="1">
                    <Image x:Name="CurrentImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="In the game after replacing" Margin="0,0,0,4" />
                <Border Width="256" Height="256" Background="{StaticResource CheckerBrush}" BorderBrush="#D5DCE3" BorderThickness="1">
                    <Image x:Name="NewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
            </StackPanel>
        </Grid>

        <ItemsControl x:Name="NoteList" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <BulletDecorator Margin="0,2">
                        <BulletDecorator.Bullet>
                            <TextBlock Text="•" Margin="0,0,6,0" />
                        </BulletDecorator.Bullet>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </BulletDecorator>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Replace" IsDefault="True" Click="OnReplace" Style="{StaticResource DialogButton}" />
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
        </StackPanel>
    </StackPanel>
</Window>
