<Window x:Class="PW64Editor.App.Dialogs.CodeFixOfferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Code fixes available"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock TextWrapping="Wrap"
                   Text="This project does not contain the following corrections of bugs in the game's code yet. They are recommended for every hack, because the bugs can crash the game or damage data." />

        <ItemsControl x:Name="FixList" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8" Padding="10,8" BorderBrush="#D5DCE3" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                                <Run Text="Problem: " FontWeight="SemiBold" /><Run Text="{Binding Problem, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                                <Run Text="Fix: " FontWeight="SemiBold" /><Run Text="{Binding Solution, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                   Text="&quot;Fix it&quot; adds the fixes to the project and rebuilds the hack ROM right away. A fix cannot be removed again, except by returning to a restore point. You can also apply fixes later in File › Project settings." />

        <CheckBox x:Name="RestorePointBox" Margin="0,12,0,0"
                  Content="Create a restore point first (to be able to go back)" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Fix it" Click="OnFixIt" IsDefault="True" Style="{StaticResource DialogButton}" />
            <Button Content="Not now" IsCancel="True" Style="{StaticResource DialogButton}" />
        </StackPanel>
    </StackPanel>
</Window>
