<Window x:Class="PW64Editor.App.Dialogs.StressTestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Build stress test ROM"
        Width="500" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock TextWrapping="Wrap"
                   Text="Builds a test ROM from the clean ROM that should play exactly like the original. It checks that the build pipeline works, e.g. in an emulator. Your project is not used." />

        <CheckBox x:Name="RecompressBox" Margin="0,16,0,0"
                  Content="Recompress every game file with the editor's MIO0 compressor" />
        <CheckBox x:Name="RelocateBox" Margin="0,8,0,0"
                  Content="Always move the audio data directly behind the game files" />
        <CheckBox x:Name="ExpandBox" Margin="0,8,0,0"
                  Content="Allow enlarging the ROM when the data does not fit" />

        <TextBlock Text="Add an unused file of this many bytes (empty for none)" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
        <TextBox x:Name="DummyBox" Width="160" HorizontalAlignment="Left" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Build…" Click="OnBuild" IsDefault="True" Style="{StaticResource DialogButton}" />
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
        </StackPanel>
    </StackPanel>
</Window>
