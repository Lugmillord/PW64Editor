<Window x:Class="PW64Editor.App.Dialogs.TextImportReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Text import"
        Width="620" Height="460" MinWidth="400" MinHeight="260"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" TextWrapping="Wrap" />
        <TextBlock DockPanel.Dock="Top" Margin="0,12,0,6" FontWeight="SemiBold"
                   Text="The following texts could not be imported. Their current texts were kept:" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" IsDefault="True" IsCancel="True" Style="{StaticResource DialogButton}" />
        </StackPanel>

        <Border BorderBrush="#D5DCE3" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ProblemList" Margin="8,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding Reason}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
