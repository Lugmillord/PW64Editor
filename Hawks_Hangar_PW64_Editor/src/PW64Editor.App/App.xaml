<Application x:Class="PW64Editor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="StartWindow.xaml"
             DispatcherUnhandledException="OnDispatcherUnhandledException">
    <Application.Resources>
        <!-- Shared look: the accent is a deep sky blue, taken from the game's cloudless skies. -->
        <SolidColorBrush x:Key="AccentBrush" Color="#1E4F7A" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#5A6573" />

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
    </Application.Resources>
</Application>
