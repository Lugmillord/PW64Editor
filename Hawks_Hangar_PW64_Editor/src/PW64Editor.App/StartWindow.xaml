<Window x:Class="PW64Editor.App.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hawk's Hangar"
        Width="720" Height="500"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: name and the three main actions. -->
        <Border Grid.Column="0" Background="{StaticResource AccentBrush}" Padding="28,32">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Hawk's Hangar" FontSize="30" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentTextBrush}" />
                    <TextBlock Text="ROM hacking for Pilotwings 64" FontSize="14" Margin="0,4,0,0"
                               Foreground="#C9D9E8" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <Button Content="New project…" Click="OnNewProject" Padding="10,8" Margin="0,0,0,10" IsDefault="True" />
                    <Button Content="Open project…" Click="OnOpenProject" Padding="10,8" Margin="0,0,0,18" />
                    <Button Content="Copy project…" Click="OnCopyProject" Padding="10,8" Margin="0,0,0,10"
                            ToolTip="Copies a project folder under a new name and opens the copy." />
                    <Button Content="Project from ROM…" Click="OnProjectFromRom" Padding="10,8" Margin="0,0,0,10"
                            ToolTip="Makes a project from a hack ROM: changed game files, songs, code fixes and, for hacks built with Hawk's Hangar, their settings." />
                    <Button Content="Project from patch…" Click="OnProjectFromPatch" Padding="10,8" Margin="0,0,0,18"
                            ToolTip="Applies a BPS patch to the clean ROM and makes a project from the result." />
                    <Button Content="Exit" Click="OnExit" Padding="10,8" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Right: recently opened projects. -->
        <DockPanel Grid.Column="1" Margin="24,28,24,24">
            <TextBlock DockPanel.Dock="Top" Text="Recent projects" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
            <TextBlock DockPanel.Dock="Bottom" Text="Double-click a project to open it." Margin="0,8,0,0"
                       Foreground="{StaticResource MutedTextBrush}" />
            <Grid>
                <ListBox x:Name="RecentList" MouseDoubleClick="OnRecentDoubleClick" KeyDown="OnRecentKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Folder}" Foreground="{StaticResource MutedTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open" Click="OnRecentOpen" />
                            <MenuItem Header="Remove from list" Click="OnRecentRemove" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
                <TextBlock x:Name="EmptyRecentText" Text="Projects you create or open will appear here."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}" />
            </Grid>
        </DockPanel>
    </Grid>
</Window>
